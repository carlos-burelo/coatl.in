---
const props = Astro.props;
---

<div class="overflow-x-auto my-4 pb-2 rounded-lg bg-(--background-color)">
    <table {...props} class="w-full border-spacing-0 border border-(--border-color) rounded-lg text-[0.9em]">
        <slot />
    </table>
</div>

<style>
    div::-webkit-scrollbar { height: 8px; }
    div::-webkit-scrollbar-thumb { background-color: var(--border-color); border-radius: 4px; }
    div::-webkit-scrollbar-track { background-color: var(--background-color); }

    :global(th) { white-space: nowrap; }
    :global(th), :global(td) {
        padding: 0.5em;
        border-right: 1px solid var(--border-color);
        border-bottom: 1px solid var(--border-color);
        text-overflow: ellipsis;
        overflow: hidden;
        white-space: nowrap;
        font-size: 0.9em;
    }
    :global(th:last-child), :global(td:last-child) { border-right: none; }
    :global(tr:last-child td) { border-bottom: none; }
</style>
