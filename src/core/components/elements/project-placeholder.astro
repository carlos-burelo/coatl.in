---
export interface Props {
    title: string;
    stack: Record<string, number>;
}

const { title, stack } = Astro.props;
const langs = Object.keys(stack);
const primary = langs[0] ?? 'js';

const LANG_PALETTES: Record<string, { bg: string; accent: string; text: string }> = {
    ts:      { bg: '#1a3a6b', accent: '#5b9cf6', text: '#93c5fd' },
    js:      { bg: '#3b2a00', accent: '#fbbf24', text: '#fde68a' },
    python:  { bg: '#1a2f4a', accent: '#60a5fa', text: '#bae6fd' },
    rust:    { bg: '#3b1515', accent: '#f87171', text: '#fca5a5' },
    go:      { bg: '#002b36', accent: '#22d3ee', text: '#a5f3fc' },
    java:    { bg: '#2e1a00', accent: '#fb923c', text: '#fed7aa' },
    css:     { bg: '#2e1065', accent: '#a78bfa', text: '#ddd6fe' },
    html:    { bg: '#3b1500', accent: '#f97316', text: '#fed7aa' },
    kotlin:  { bg: '#2d1a4b', accent: '#c084fc', text: '#e9d5ff' },
    swift:   { bg: '#3b0f00', accent: '#fb923c', text: '#fde68a' },
    dart:    { bg: '#00282e', accent: '#34d399', text: '#a7f3d0' },
    php:     { bg: '#1e1b4b', accent: '#818cf8', text: '#c7d2fe' },
    ruby:    { bg: '#3b0a0a', accent: '#f87171', text: '#fecaca' },
    shell:   { bg: '#0f2318', accent: '#4ade80', text: '#bbf7d0' },
    graphql: { bg: '#3b0033', accent: '#e879f9', text: '#f5d0fe' },
};

const palette = LANG_PALETTES[primary] ?? { bg: '#0f1c3b', accent: '#4a80e8', text: '#93c5fd' };
const initials = title.split(' ').map((w: string) => w[0]).join('').slice(0, 2).toUpperCase();
const gId = `g${primary}${initials}`.replace(/[^a-zA-Z0-9]/g, '');
---

<svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
        <radialGradient id={`${gId}r`} cx="30%" cy="30%" r="70%">
            <stop offset="0%" stop-color={palette.accent} stop-opacity="0.3" />
            <stop offset="100%" stop-color={palette.bg} stop-opacity="0" />
        </radialGradient>
        <radialGradient id={`${gId}r2`} cx="80%" cy="75%" r="55%">
            <stop offset="0%" stop-color={palette.accent} stop-opacity="0.15" />
            <stop offset="100%" stop-color={palette.bg} stop-opacity="0" />
        </radialGradient>
    </defs>

    <!-- solid bg -->
    <rect width="400" height="300" fill={palette.bg} />

    <!-- glow blobs -->
    <rect width="400" height="300" fill={`url(#${gId}r)`} />
    <rect width="400" height="300" fill={`url(#${gId}r2)`} />

    <!-- subtle grid -->
    {[50,100,150,200,250,300,350].map((x: number) => (
        <line x1={x} y1="0" x2={x} y2="300" stroke={palette.accent} stroke-width="0.5" opacity="0.07" />
    ))}
    {[50,100,150,200,250].map((y: number) => (
        <line x1="0" y1={y} x2="400" y2={y} stroke={palette.accent} stroke-width="0.5" opacity="0.07" />
    ))}

    <!-- large bg initials (decorative) -->
    <text
        x="200" y="210"
        text-anchor="middle"
        font-family="ui-monospace, monospace"
        font-size="200"
        font-weight="900"
        fill={palette.accent}
        opacity="0.04"
        letter-spacing="-8"
    >{initials}</text>

    <!-- center monogram -->
    <circle cx="200" cy="140" r="56" fill={palette.accent} opacity="0.1" />
    <circle cx="200" cy="140" r="40" fill={palette.accent} opacity="0.12" />
    <circle cx="200" cy="140" r="28" fill={palette.accent} opacity="0.15" />
    <text
        x="200" y="150"
        text-anchor="middle"
        font-family="ui-monospace, monospace"
        font-size="28"
        font-weight="800"
        fill={palette.text}
        opacity="0.95"
    >{initials}</text>

    <!-- top accent bar -->
    <rect x="0" y="0" width="400" height="3" fill={palette.accent} opacity="0.8" />

    <!-- lang badge top-left -->
    <rect x="14" y="14" width={primary.length * 10 + 18} height="24" rx="6" fill={palette.accent} opacity="0.25" />
    <rect x="14" y="14" width={primary.length * 10 + 18} height="24" rx="6" fill="none" stroke={palette.accent} stroke-width="1" opacity="0.5" />
    <text x="23" y="30" font-family="ui-monospace, monospace" font-size="11" font-weight="700" fill={palette.text} opacity="1">
        {primary.toUpperCase()}
    </text>

    <!-- stack bars top-right -->
    {langs.slice(0, 4).map((lang: string, i: number) => {
        const barW = Math.min((stack[lang] / 100) * 88, 88);
        return (
            <>
                <rect x="298" y={16 + i * 13} width="88" height="5" rx="2.5" fill={palette.accent} opacity="0.12" />
                <rect x="298" y={16 + i * 13} width={barW} height="5" rx="2.5" fill={palette.accent} opacity="0.6" />
            </>
        );
    })}

    <!-- decorative corner circles -->
    <circle cx="370" cy="260" r="60" fill={palette.accent} opacity="0.05" />
    <circle cx="370" cy="260" r="35" fill={palette.accent} opacity="0.06" />
    <circle cx="30" cy="270" r="40" fill={palette.accent} opacity="0.05" />
</svg>
