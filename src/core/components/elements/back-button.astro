---
import Icon from "./icon.astro";
---

<button
    type="button"
    onclick="window.history.back()"
    aria-label="Back button"
    class="rotate-180 grid place-items-center text-[1em] w-max bg-bg text-fg-paragraph border border-border rounded p-2 cursor-pointer transition-all duration-200 ease hover:border-primary hover:text-primary"
>
    <Icon name="arrow-left" />
</button>
