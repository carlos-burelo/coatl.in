---
const { id } = Astro.props;
---

<dialog
    id={id}
    class="min-w-87.5 min-h-fit max-h-87.5 fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 border border-border bg-bg-dialog rounded-lg animate-[overlap_0.2s_ease-in-out] backdrop:inset-0 backdrop:backdrop-blur-sm backdrop:bg-bg-backdrop"
>
    <div class="p-2 grid gap-4 bg-bg relative">
        <slot />
    </div>
</dialog>

<style>
    @keyframes overlap {
        from {
            opacity: 0.4;
            transform: translate(-50%, -40%);
        }
        to {
            opacity: 1;
            transform: translate(-50%, -50%);
        }
    }
    dialog::backdrop {
        inset: 0px;
        backdrop-filter: blur(4px);
        background-color: var(--background-color-backdrop);
        transition: background-color 0.2s ease-in-out;
    }
</style>

<script defer is:inline define:vars={{ id }}>
    const dialog = document.querySelector(`#${id}`);
    dialog.addEventListener(
        "click",
        (e) => e.target === dialog && dialog.close(),
    );
</script>
