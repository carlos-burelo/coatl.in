---
import Icon from "./icon.astro";
const { href, text, icon, target } = Astro.props;
---

<a
    href={href}
    target={target}
    class="p-3 rounded-lg grid grid-flow-col justify-start gap-4 text-fg-links transition-[background-color,color] duration-150 ease-in-out hover:bg-bg-link-hover hover:text-primary"
>
    <i class="text-[0.7em] stroke-[2.5] grid place-content-center not-italic"><Icon name={icon} /></i>
    <span>{text}</span>
</a>
